# ---------------------------------------------------------------------------
# Bridge-Agents example configuration.
# Copy this file to .env and adjust the values for your machine.
# Every value below is a placeholder: no credentials and no absolute paths.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Bridge-Agents
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# HTTP security (comma-separated lists; use explicit values in production)
CORS_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/bridge-agents.db
STORAGE_DIR=./data/uploads
DOCS_DIR=./docs/kb
DEFAULT_TIMEZONE=UTC
MAX_IMAGE_SIZE=10485760

# Authentication
# hs256: locally issued tokens (default, demo friendly)
# rs256_pem: verify tokens against a PEM public key file
# jwks: verify tokens against an OIDC JWKS endpoint
AUTH_VERIFIER=hs256
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=bridge-agents
JWT_AUDIENCE=
JWT_EXPIRES_MINUTES=1440
RS256_PUBLIC_KEY_PATH=
JWKS_URL=
JWKS_CACHE_SECONDS=300
# Demo-only login endpoint. Keep false outside local development.
ALLOW_DEV_LOGIN=false

# Knowledge base and retrieval-augmented generation
# Documents are seeded from DOCS_DIR into KNOWLEDGE_DIR on first start.
KNOWLEDGE_DIR=./data/knowledge
RAG_ENABLED=true
# hash: deterministic offline embedder (default); openai: any /v1/embeddings endpoint
RAG_EMBEDDER=hash
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONTEXT_CHARS=2400

# LLM (mock mode keeps the demo reproducible without any API key)
# These values are defaults; Studio -> Settings can override the model endpoint,
# model, sampling settings and API key at runtime (stored in the database).
LLM_MODE=mock
OPENAI_BASE_URL=http://mock-llm:8001/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=mock-model
OPENAI_THINKING_ENABLED=false

OPENAI_TEMPERATURE=1.0
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# Optional provider moderation for the sanitize node
# Leave MODERATION_BASE_URL empty to reuse OPENAI_BASE_URL
MODERATION_BASE_URL=
MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT=5

# Agent runtime
# Tool binding also requires a graph edge that routes tool calls from an agent node.
AGENT_TOOLS_ENABLED=true
AGENT_TOOLS=["get_current_time", "calculate", "search_docs"]
# Empty value uses the built-in prompt-injection guard patterns.
AGENT_INJECTION_PATTERNS=

# Realtime gateway
WS_MAX_CONNECTIONS=10000

# Lark channel (disabled by default; no outbound calls are made while disabled)
LARK_ENABLED=false
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=
LARK_AGENT_OPEN_IDS=
# Comma-separated canonical commands enabled in Lark chats.
LARK_COMMANDS=/takeover,/release,/status,/help
LARK_API_BASE_URL=https://open.feishu.cn
